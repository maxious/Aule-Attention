; SPIR-V Assembly demonstrating native bfloat16 with SPV_KHR_bfloat16
; This is a minimal compute shader that:
;   1. Loads bf16 values from a buffer
;   2. Converts to f32
;   3. Performs computation
;   4. Converts back to bf16
;   5. Stores result

               OpCapability Shader
               OpCapability StorageBuffer16BitAccess
               OpCapability BFloat16TypeKHR
               OpExtension "SPV_KHR_bfloat16"
               OpExtension "SPV_KHR_16bit_storage"
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %gl_GlobalInvocationID %input_buf %output_buf
               OpExecutionMode %main LocalSize 64 1 1
               
               ; Decorations
               OpDecorate %gl_GlobalInvocationID BuiltIn GlobalInvocationId
               OpDecorate %input_buf DescriptorSet 0
               OpDecorate %input_buf Binding 0
               OpDecorate %output_buf DescriptorSet 0
               OpDecorate %output_buf Binding 1
               
               ; Buffer block decorations
               OpDecorate %InputBlock Block
               OpMemberDecorate %InputBlock 0 Offset 0
               OpDecorate %_runtimearr_bf16 ArrayStride 2
               
               OpDecorate %OutputBlock Block  
               OpMemberDecorate %OutputBlock 0 Offset 0
               OpDecorate %_runtimearr_bf16_out ArrayStride 2

       ; Types
       %void = OpTypeVoid
   %voidfunc = OpTypeFunction %void
      %float = OpTypeFloat 32
       %uint = OpTypeInt 32 0
        %int = OpTypeInt 32 1
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
    %uint_64 = OpConstant %uint 64
     %v3uint = OpTypeVector %uint 3
%ptr_v3uint = OpTypePointer Input %v3uint
%ptr_uint   = OpTypePointer Input %uint

; BFloat16 type - 16-bit float with BFloat16KHR encoding
      %bf16 = OpTypeFloat 16 BFloat16KHR

; Runtime arrays for buffers
%_runtimearr_bf16 = OpTypeRuntimeArray %bf16
%_runtimearr_bf16_out = OpTypeRuntimeArray %bf16

; Buffer structs
  %InputBlock = OpTypeStruct %_runtimearr_bf16
 %OutputBlock = OpTypeStruct %_runtimearr_bf16_out

; Pointers to buffers
%ptr_InputBlock = OpTypePointer StorageBuffer %InputBlock
%ptr_OutputBlock = OpTypePointer StorageBuffer %OutputBlock
%ptr_bf16_in = OpTypePointer StorageBuffer %bf16
%ptr_bf16_out = OpTypePointer StorageBuffer %bf16

; Global variables
%gl_GlobalInvocationID = OpVariable %ptr_v3uint Input
%input_buf = OpVariable %ptr_InputBlock StorageBuffer
%output_buf = OpVariable %ptr_OutputBlock StorageBuffer

; Constants for computation
   %float_2 = OpConstant %float 2.0

       %main = OpFunction %void None %voidfunc
      %entry = OpLabel

               ; Get global invocation ID.x
         %id = OpAccessChain %ptr_uint %gl_GlobalInvocationID %uint_0
      %gid_x = OpLoad %uint %id

               ; Load bf16 value from input buffer
    %in_ptr = OpAccessChain %ptr_bf16_in %input_buf %uint_0 %gid_x
   %bf16_val = OpLoad %bf16 %in_ptr

               ; Convert bf16 to f32 for computation
    %f32_val = OpFConvert %float %bf16_val

               ; Perform computation (multiply by 2)
    %result32 = OpFMul %float %f32_val %float_2

               ; Convert f32 result back to bf16
  %result_bf16 = OpFConvert %bf16 %result32

               ; Store result to output buffer
   %out_ptr = OpAccessChain %ptr_bf16_out %output_buf %uint_0 %gid_x
               OpStore %out_ptr %result_bf16

               OpReturn
               OpFunctionEnd
