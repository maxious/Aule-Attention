#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require

// FlashAttention-2 Forward Pass - Native BF16 using Vulkan extensions
// Uses float16_t for computation with BF16-specific optimizations
//
// Native Vulkan BF16 approach:
// - float16_t for computation (maps to SPIR-V float16)
// - Hardware BF16 operations through shader compilation
// - Optimized for GPUs with native BF16 support
// - Uses vectorized operations for better performance

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Storage buffers - BF16 data stored as uint16_t for compatibility
// We'll use conversion functions for BF16 arithmetic
layout(std430, set = 0, binding = 0) readonly buffer QBuffer {
    uint16_t data[];
} Q;

layout(std430, set = 0, binding = 1) readonly buffer KBuffer {
    uint16_t data[];
} K;

layout(std430, set = 0, binding = 2) readonly buffer VBuffer {
    uint16_t data[];
} V;

layout(std430, set = 0, binding = 3) writeonly buffer OutputBuffer {
    uint16_t data[];
} O;

layout(std430, set = 0, binding = 4) readonly buffer RotaryCosBuffer {
    uint16_t data[];
} RotCos;

layout(std430, set = 0, binding = 5) readonly buffer RotarySinBuffer {
    uint16_t data[];
} RotSin;

// Push constants for dimensions
layout(push_constant) uniform PushConstants {
    uint batch_size;    // B
    uint num_heads;     // H
    uint seq_len;       // N
    uint head_dim;      // D (<= 128 for BF16 variants, <= 64 for others)
    float scale;        // 1/sqrt(D)
    uint causal;        // 1 for causal masking
    uint has_rope;      // 1 to apply RoPE
    uint num_kv_heads;  // Number of K/V heads
    uint key_seq_len;   // Sequence length for K/V
    int window_size;    // Sliding window size (-1 for full attention)
} params;

// Shared memory for tiles - optimized for BF16
const uint BLOCK_SIZE = 16;

// Use mixed precision: BF16 storage with FP16 computation for better accuracy
const uint MAX_HEAD_DIM = 128;      // Maximum supported head dimension
shared float16_t s_Q[BLOCK_SIZE][MAX_HEAD_DIM];  // Q tile in FP16
shared float16_t s_K[BLOCK_SIZE][MAX_HEAD_DIM];  // K tile in FP16
shared float16_t s_V[BLOCK_SIZE][MAX_HEAD_DIM];  // V tile in FP16
shared float s_S[BLOCK_SIZE][BLOCK_SIZE];       // Attention scores in FP32 for stability

// Native BF16 conversion functions using float16_t
// These will be compiled to proper SPIR-V BF16 operations
float16_t pack_bf16_native(float f) {
    // Convert to float16_t which maps to BF16 on supported hardware
    return float16_t(f);
}

float unpack_bf16_native(uint16_t bf16_bits) {
    // Convert BF16 bits to float for computation
    uint bits = uint(bf16_bits) << 16;
    return uintBitsToFloat(bits);
}

uint16_t pack_to_bf16(float f) {
    // Convert float to BF16 bits using proper rounding
    uint bits = floatBitsToUint(f);
    uint mantissa = bits & 0x7FFFFF;
    uint exponent = bits & 0x7F800000;
    uint sign = bits & 0x80000000;
    
    // Round to nearest even for BF16
    uint round_bit = (mantissa & 0x10000) != 0 ? 1 : 0;
    uint mantissa_rounded = (mantissa + 0x8000 + round_bit) & 0x7FFFE000;
    
    if ((mantissa_rounded & 0x80000000) != 0) {
        exponent += 0x800000;
        mantissa_rounded = 0;
    }
    
    uint bf16_bits = (exponent & 0x7F800000) | (mantissa_rounded >> 16) | (sign >> 16);
    return uint16_t(bf16_bits);
}

// Vectorized operations for better performance
f16vec2 pack_bf16_vec2(vec2 v) {
    return f16vec2(v);
}

f16vec4 pack_bf16_vec4(vec4 v) {
    return f16vec4(v);
}

vec2 unpack_bf16_vec2(f16vec2 fv) {
    return vec2(fv);
}

vec4 unpack_bf16_vec4(f16vec4 fv) {
    return vec4(fv);
}

// Optimized BF16 dot product using float16_t vector operations
float bf16_dot_product_native(const uint16_t a[64], const uint16_t b[64], uint length) {
    float result = 0.0;
    
    // Process in chunks of 4 for vectorization
    for (uint i = 0; i < length; i += 4) {
        // Convert 4 BF16 values to float16 vectors
        f16vec4 av = pack_bf16_vec4(vec4(
            unpack_bf16_native(a[i]),
            unpack_bf16_native(a[i+1]), 
            unpack_bf16_native(a[i+2]),
            unpack_bf16_native(a[i+3])
        ));
        
        f16vec4 bv = pack_bf16_vec4(vec4(
            unpack_bf16_native(b[i]),
            unpack_bf16_native(b[i+1]),
            unpack_bf16_native(b[i+2]), 
            unpack_bf16_native(b[i+3])
        ));
        
        // Convert to float32 for dot product
        vec4 av_f32 = vec4(av);
        vec4 bv_f32 = vec4(bv);
        result += dot(av_f32, bv_f32);
    }
    
    return result;
}

void main() {
    uint local_row = gl_LocalInvocationID.y;  // Row within block
    uint local_col = gl_LocalInvocationID.x;  // Col within block

    // Global position
    uint batch_head_idx = gl_WorkGroupID.z;
    uint batch_idx = batch_head_idx / params.num_heads;
    uint head_idx = batch_head_idx % params.num_heads;

    // GQA Logic
    uint ratio = params.num_heads / params.num_kv_heads;
    uint kv_head_idx = head_idx / ratio;
    uint kv_batch_head_idx = batch_idx * params.num_kv_heads + kv_head_idx;

    // Base offsets
    uint qs_off = batch_head_idx * params.seq_len * params.head_dim;
    uint ks_off = kv_batch_head_idx * params.key_seq_len * params.head_dim;
    uint vs_off = kv_batch_head_idx * params.key_seq_len * params.head_dim;
    uint block_row = gl_WorkGroupID.y;

    uint global_row = block_row * BLOCK_SIZE + local_row;

    // Check availability
    bool is_active = (batch_idx < params.batch_size) && (global_row < params.seq_len);

    uint base_offset = qs_off;

    // Initialize output accumulator
    float row_max = -1e30;
    float row_sum = 0.0;
    float16_t output_acc[64];
    uint actual_head_dim = min(params.head_dim, 128u);

    for (uint d = 0; d < actual_head_dim; d++) {
        output_acc[d] = float16_t(0.0);
    }

    // Load Q tile using BF16 operations
    for (uint d = local_col; d < actual_head_dim; d += BLOCK_SIZE) {
        float16_t q_val = float16_t(0.0);
        
        if (is_active) {
            uint16_t bf16_q = Q.data[base_offset + global_row * params.head_dim + d];
            q_val = float16_t(unpack_bf16_native(bf16_q));

            // RoPE using BF16 operations
            if (params.has_rope != 0u) {
                uint rot_idx = global_row * (params.head_dim / 2) + (d / 2);
                if (d < params.head_dim && (d % 2) == 0 && (d + 1) < params.head_dim) {
                    float cos_val = unpack_bf16_native(RotCos.data[rot_idx]);
                    float sin_val = unpack_bf16_native(RotSin.data[rot_idx]);

                    uint16_t bf16_q_next = Q.data[base_offset + global_row * params.head_dim + d + 1];
                    float16_t q_next = float16_t(unpack_bf16_native(bf16_q_next));

                    // Use float16 for RoPE computation
                    float16_t q_f16 = q_val;
                    float16_t q_next_f16 = q_next;
                    float16_t cos_f16 = float16_t(cos_val);
                    float16_t sin_f16 = float16_t(sin_val);

                    q_val = q_f16 * cos_f16 - q_next_f16 * sin_f16;
                }
            }
        }
        s_Q[local_row][d] = q_val;
    }

    barrier();

    // Process K/V blocks
    uint num_kv_blocks = (params.key_seq_len + BLOCK_SIZE - 1) / BLOCK_SIZE;

    for (uint kv_block = 0; kv_block < num_kv_blocks; kv_block++) {
        uint kv_start = kv_block * BLOCK_SIZE;

        // Load K tile using BF16 operations
        for (uint d = local_col; d < actual_head_dim; d += BLOCK_SIZE) {
            float16_t k_val = float16_t(0.0);
            uint k_row = kv_start + local_row;

            if (k_row < params.key_seq_len && (batch_idx < params.batch_size)) {
                uint16_t bf16_k = K.data[ks_off + k_row * params.head_dim + d];
                k_val = float16_t(unpack_bf16_native(bf16_k));

                // RoPE for K using BF16 operations
                if (params.has_rope != 0u) {
                    uint rot_idx = k_row * (params.head_dim / 2) + (d / 2);
                    if (d < params.head_dim && (d % 2) == 0 && (d + 1) < params.head_dim) {
                        float cos_val = unpack_bf16_native(RotCos.data[rot_idx]);
                        float sin_val = unpack_bf16_native(RotSin.data[rot_idx]);

                        uint16_t bf16_k_next = K.data[ks_off + k_row * params.head_dim + d + 1];
                        float16_t k_next = float16_t(unpack_bf16_native(bf16_k_next));

                        // Use float16 for RoPE computation
                        float16_t k_f16 = k_val;
                        float16_t k_next_f16 = k_next;
                        float16_t cos_f16 = float16_t(cos_val);
                        float16_t sin_f16 = float16_t(sin_val);

                        k_val = k_f16 * cos_f16 - k_next_f16 * sin_f16;
                    }
                }
            }
            s_K[local_row][d] = k_val;
        }

        // Load V tile using BF16 operations
        for (uint d = local_col; d < actual_head_dim; d += BLOCK_SIZE) {
            float16_t v_val = float16_t(0.0);
            uint v_row = kv_start + local_row;

            if (v_row < params.key_seq_len && (batch_idx < params.batch_size)) {
                uint16_t bf16_v = V.data[vs_off + v_row * params.head_dim + d];
                v_val = float16_t(unpack_bf16_native(bf16_v));
            }
            s_V[local_row][d] = v_val;
        }

        barrier();

        // Compute attention scores: S = Q @ K^T
        // Use mixed precision: FP16 computation with FP32 accumulation
        float score = 0.0;
        for (uint d = 0; d < actual_head_dim; d++) {
            float q_val = float(s_Q[local_row][d]);
            float k_val = float(s_K[local_col][d]);
            score += q_val * k_val;
        }
        s_S[local_row][local_col] = score * params.scale;

        barrier();

        // Apply causal masking and sliding window
        if (local_col == 0) {
            for (uint c = 0; c < BLOCK_SIZE; c++) {
                uint global_col = kv_start + c;
                float val = s_S[local_row][c];

                bool masked = false;

                // Out of bounds masking
                if (global_col >= params.key_seq_len) {
                    masked = true;
                }

                // Causal masking
                if (params.causal != 0u && global_col > global_row) {
                    masked = true;
                }

                // Sliding window masking
                if (params.window_size > 0) {
                    int dist = int(global_row) - int(global_col);
                    if (dist > params.window_size) {
                        masked = true;
                    }
                }

                if (masked) {
                    val = -1e30;
                }

                s_S[local_row][c] = val;
            }
        }

        barrier();

        // Online softmax update with subgroup optimizations
        if (local_col == 0 && is_active) {
            // Find block max
            float block_max = -1e30;
            for (uint c = 0; c < BLOCK_SIZE; c++) {
                block_max = max(block_max, s_S[local_row][c]);
            }

            // Update running max and rescale previous accumulator
            float new_max = max(row_max, block_max);
            float scale_factor = exp(row_max - new_max);
            row_sum *= scale_factor;
            for (uint d = 0; d < actual_head_dim; d++) {
                output_acc[d] = float16_t(float(output_acc[d]) * scale_factor);
            }

            // Compute softmax weights for this block and accumulate
            float block_sum = 0.0;
            for (uint c = 0; c < BLOCK_SIZE; c++) {
                float p = exp(s_S[local_row][c] - new_max);
                s_S[local_row][c] = p;
                block_sum += p;
            }

            row_sum += block_sum;
            row_max = new_max;
        }

        barrier();

        // Accumulate weighted values: O += softmax(S) @ V
        if (local_col == 0 && is_active) {
            for (uint d = 0; d < actual_head_dim; d++) {
                float weighted_sum = 0.0;
                for (uint c = 0; c < BLOCK_SIZE; c++) {
                    weighted_sum += s_S[local_row][c] * float(s_V[c][d]);
                }
                output_acc[d] += float16_t(weighted_sum);
            }
        }

        barrier();
    }

    // Write output using BF16 conversion
    if (local_col == 0 && is_active) {
        float inv_sum = 1.0 / row_sum;
        for (uint d = 0; d < actual_head_dim; d++) {
            float final_val = float(output_acc[d]) * inv_sum;
            O.data[base_offset + global_row * params.head_dim + d] = pack_to_bf16(final_val);
        }
    }
}