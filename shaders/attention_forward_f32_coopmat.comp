#version 450 core

#pragma use_vulkan_memory_model
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable

// FlashAttention-2 Forward Pass - fp32 with cooperative matrix infrastructure
// Currently uses scalar Q*K^T computation for correctness
// Cooperative matrix operations require hardware-specific tuning
//
// TODO: Enable coopmat path after validating supported matrix configurations
// Intel Arc may require bf16 types or specific MxNxK dimensions

const uint BLOCK_SIZE = 16;
const uint HEAD_DIM_MAX = 64;
const uint SHMEM_STRIDE = HEAD_DIM_MAX;

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer QueryBuffer { float data[]; } Q;
layout(set = 0, binding = 1) readonly buffer KeyBuffer { float data[]; } K;
layout(set = 0, binding = 2) readonly buffer ValueBuffer { float data[]; } V;
layout(set = 0, binding = 3) writeonly buffer OutputBuffer { float data[]; } O;
layout(set = 0, binding = 4) writeonly buffer LogSumExpBuffer { float data[]; } LSE;

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_heads;
    uint seq_len;
    uint head_dim;
    float scale;
    uint causal;
    uint store_lse;
} params;

shared float s_Q[BLOCK_SIZE * SHMEM_STRIDE];
shared float s_K[BLOCK_SIZE * SHMEM_STRIDE];
shared float s_V[BLOCK_SIZE * SHMEM_STRIDE];
shared float s_S[BLOCK_SIZE * BLOCK_SIZE];

#define Q_IDX(row, col) ((row) * SHMEM_STRIDE + (col))
#define K_IDX(row, col) ((row) * SHMEM_STRIDE + (col))
#define V_IDX(row, col) ((row) * SHMEM_STRIDE + (col))
#define S_IDX(row, col) ((row) * BLOCK_SIZE + (col))

void main() {
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    uint batch_head_idx = gl_WorkGroupID.z;
    uint batch_idx = batch_head_idx / params.num_heads;
    uint head_idx = batch_head_idx % params.num_heads;
    uint block_row = gl_WorkGroupID.y;

    uint global_row = block_row * BLOCK_SIZE + local_row;
    bool is_active = (batch_idx < params.batch_size) && (global_row < params.seq_len);

    uint base_offset = (batch_idx * params.num_heads + head_idx) * params.seq_len * params.head_dim;
    uint lse_offset = (batch_idx * params.num_heads + head_idx) * params.seq_len;

    float row_max = -1e30;
    float row_sum = 0.0;
    float output_acc[HEAD_DIM_MAX];

    uint actual_head_dim = min(params.head_dim, HEAD_DIM_MAX);

    for (uint d = 0; d < HEAD_DIM_MAX; d++) {
        output_acc[d] = 0.0;
    }

    // Load Q tile into shared memory
    for (uint d = local_col; d < actual_head_dim; d += BLOCK_SIZE) {
        if (is_active) {
            s_Q[Q_IDX(local_row, d)] = Q.data[base_offset + global_row * params.head_dim + d];
        } else {
            s_Q[Q_IDX(local_row, d)] = 0.0;
        }
    }
    barrier();

    uint num_kv_blocks = (params.seq_len + BLOCK_SIZE - 1) / BLOCK_SIZE;

    for (uint kv_block = 0; kv_block < num_kv_blocks; kv_block++) {
        uint kv_start = kv_block * BLOCK_SIZE;
        uint kv_row = kv_start + local_row;
        bool kv_valid = kv_row < params.seq_len;

        // Load K and V tiles
        for (uint d = local_col; d < actual_head_dim; d += BLOCK_SIZE) {
            if (kv_valid && batch_idx < params.batch_size) {
                s_K[K_IDX(local_row, d)] = K.data[base_offset + kv_row * params.head_dim + d];
                s_V[V_IDX(local_row, d)] = V.data[base_offset + kv_row * params.head_dim + d];
            } else {
                s_K[K_IDX(local_row, d)] = 0.0;
                s_V[V_IDX(local_row, d)] = 0.0;
            }
        }
        barrier();

        // Compute S = Q @ K^T using scalar computation
        // (Cooperative matrix path disabled until hardware validation)
        float score = 0.0;
        for (uint d = 0; d < actual_head_dim; d++) {
            score += s_Q[Q_IDX(local_row, d)] * s_K[K_IDX(local_col, d)];
        }

        // Apply scaling
        score *= params.scale;
        
        uint global_col = kv_start + local_col;
        bool is_masked = !is_active || global_col >= params.seq_len;

        if (params.causal != 0u && global_col > global_row) {
            is_masked = true;
        }

        if (is_masked) {
            score = -1e30;
        }

        s_S[S_IDX(local_row, local_col)] = score;
        barrier();

        // Online softmax update
        if (is_active) {
            float block_max = -1e30;
            for (uint c = 0; c < BLOCK_SIZE; c++) {
                block_max = max(block_max, s_S[S_IDX(local_row, c)]);
            }

            float new_max = max(row_max, block_max);
            float old_scale_factor = exp(row_max - new_max);

            row_sum = row_sum * old_scale_factor;
            for (uint d = 0; d < HEAD_DIM_MAX; d++) {
                output_acc[d] *= old_scale_factor;
            }

            float block_sum = 0.0;
            for (uint c = 0; c < BLOCK_SIZE; c++) {
                float p = exp(s_S[S_IDX(local_row, c)] - new_max);
                block_sum += p;

                for (uint d = 0; d < HEAD_DIM_MAX; d++) {
                    output_acc[d] += p * s_V[V_IDX(c, d)];
                }
            }

            row_sum += block_sum;
            row_max = new_max;
        }

        barrier();
    }

    // Final output
    if (is_active) {
        float inv_sum = 1.0 / row_sum;
        for (uint d = 0; d < actual_head_dim; d++) {
            O.data[base_offset + global_row * params.head_dim + d] = output_acc[d] * inv_sum;
        }

        if (params.store_lse != 0u) {
            LSE.data[lse_offset + global_row] = row_max + log(row_sum);
        }
    }
}
