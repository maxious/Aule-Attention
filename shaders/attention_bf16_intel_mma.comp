#version 460 core

#pragma use_vulkan_memory_model
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable

// Intel Subgroup Matrix Multiply Accumulate Extension
// Enables single-instruction MMA: Result = A × B + C
// Much simpler than cooperative matrix for attention kernels

const uint SUBGROUP_SIZE = 32; // Intel Arc uses 32-wide SIMD
const uint M = 2; // Output rows per lane (Result Type = vec2)
const uint K = 16; // Inner dimension per MMA invocation

const uint BLOCK_SIZE_M = 16; // 2 lanes × 8 = 16 rows
const uint BLOCK_SIZE_N = 32; // Full subgroup = 32 columns
const uint HEAD_DIM_MAX = 64;
const uint SHMEM_STRIDE = HEAD_DIM_MAX;

layout(local_size_x = SUBGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

// bf16 I/O buffers (treated as uint16 for raw bit access)
layout(set = 0, binding = 0) readonly buffer QueryBuffer { uint16_t data[]; } Q;
layout(set = 0, binding = 1) readonly buffer KeyBuffer { uint16_t data[]; } K_buf;
layout(set = 0, binding = 2) readonly buffer ValueBuffer { uint16_t data[]; } V;
layout(set = 0, binding = 3) writeonly buffer OutputBuffer { uint16_t data[]; } O;
layout(set = 0, binding = 4) writeonly buffer LogSumExpBuffer { uint16_t data[]; } LSE;

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_heads;
    uint seq_len;
    uint head_dim;
    float scale;
    uint causal;
    uint store_lse;
} params;

// Shared memory layout:
// s_Q: BLOCK_SIZE_M × HEAD_DIM_MAX (float, unpacked for reuse)
// s_K: BLOCK_SIZE_N × HEAD_DIM_MAX (float, unpacked)
// s_V: BLOCK_SIZE_N × HEAD_DIM_MAX (float, unpacked)
// s_S: BLOCK_SIZE_M × BLOCK_SIZE_N (float, attention scores)

shared float s_Q[BLOCK_SIZE_M * SHMEM_STRIDE];
shared float s_K[BLOCK_SIZE_N * SHMEM_STRIDE];
shared float s_V[BLOCK_SIZE_N * SHMEM_STRIDE];
shared float s_S[BLOCK_SIZE_M * BLOCK_SIZE_N];

#define Q_IDX(row, col) ((row) * SHMEM_STRIDE + (col))
#define K_IDX(row, col) ((row) * SHMEM_STRIDE + (col))
#define V_IDX(row, col) ((row) * SHMEM_STRIDE + (col))
#define S_IDX(row, col) ((row) * BLOCK_SIZE_N + (col))

// BF16 Helper Functions
float unpackBfloat16(uint16_t val) {
    uint val32 = uint(val) << 16;
    return uintBitsToFloat(val32);
}

uint16_t packBfloat16(float val) {
    uint val32 = floatBitsToUint(val);
    return uint16_t(val32 >> 16);
}

void main() {
    uint lane_id = gl_SubgroupLocalInvocationID;
    uint subgroup_id = gl_SubgroupID;

    uint batch_head_idx = gl_WorkGroupID.z;
    uint batch_idx = batch_head_idx / params.num_heads;
    uint head_idx = batch_head_idx % params.num_heads;
    uint block_row = gl_WorkGroupID.y;

    uint global_row_base = block_row * BLOCK_SIZE_M;
    bool is_active_base = (batch_idx < params.batch_size);

    uint base_offset = (batch_idx * params.num_heads + head_idx) * params.seq_len * params.head_dim;
    uint lse_offset = (batch_idx * params.num_heads + head_idx) * params.seq_len;

    // Output accumulator and LSE tracking
    float row_max = -1e30;
    float row_sum = 0.0;
    float output_acc[HEAD_DIM_MAX];

    uint actual_head_dim = min(params.head_dim, HEAD_DIM_MAX);
    uint num_k_blocks = (actual_head_dim + K - 1) / K;

    // Initialize accumulators
    for (uint d = 0; d < HEAD_DIM_MAX; d++) {
        output_acc[d] = 0.0;
    }

    // ========================================
    // Load Q into Shared Memory (Unpack BF16 → float)
    // ========================================
    // Lane 0-15: rows 0-7, Lane 16-31: rows 8-15
    uint q_row = lane_id % 8;
    uint q_row_global = global_row_base + q_row;

    // Each lane loads its two Q elements (at k_idx and k_idx+K)
    for (uint k_idx = 0; k_idx < actual_head_dim; k_idx += K) {
        for (uint k_off = 0; k_off < K; k_off += 2) {
            uint col = k_idx + k_off;

            float val = 0.0;
            if (q_row_global < params.seq_len and is_active_base and col < actual_head_dim) {
                val = unpackBfloat16(Q.data[base_offset + q_row_global * params.head_dim + col]);
            }
            // Store at row (lane%8), column = col
            s_Q[Q_IDX(q_row, col)] = val;
        }
    }

    // Zero padding for Q if head_dim not multiple of K
    if (actual_head_dim < BLOCK_SIZE_M * HEAD_DIM_MAX / SHMEM_STRIDE) {
        for (uint col = actual_head_dim; col < HEAD_DIM_MAX; col++) {
            s_Q[Q_IDX(q_row, col)] = 0.0;
        }
    }

    subgroupBarrier();

    // ========================================
    // Process K blocks and compute Q @ K^T
    // ========================================
    uint num_kv_blocks = (params.seq_len + BLOCK_SIZE_N - 1) / BLOCK_SIZE_N;

    for (uint kv_block = 0; kv_block < num_kv_blocks; kv_block++) {
        uint kv_start = kv_block * BLOCK_SIZE_N;

        // ========================================
        // Load K into Shared Memory (Unpack BF16 → float)
        // ========================================
        uint k_row = lane_id; // Each lane handles one row of K (0-31)
        uint k_row_global = kv_start + k_row;

        for (uint k_idx = 0; k_idx < actual_head_dim; k_idx += K) {
            for (uint k_off = 0; k_off < K; k_off += 2) {
                uint col = k_idx + k_off;

                float val = 0.0;
                if (k_row_global < params.seq_len and is_active_base and col < actual_head_dim) {
                    val = unpackBfloat16(K_buf.data[base_offset + k_row_global * params.head_dim + col]);
                }
                s_K[K_IDX(k_row, col)] = val;
            }
        }

        // Load V into Shared Memory (needed for softmax weighting)
        for (uint col = 0; col < HEAD_DIM_MAX; col++) {
            float v_val = 0.0;
            if (k_row_global < params.seq_len and is_active_base and col < actual_head_dim) {
                v_val = unpackBfloat16(V.data[base_offset + k_row_global * params.head_dim + col]);
            }
            s_V[V_IDX(k_row, col)] = v_val;
        }

        // Zero padding
        if (actual_head_dim < BLOCK_SIZE_M * HEAD_DIM_MAX / SHMEM_STRIDE) {
            for (uint col = actual_head_dim; col < HEAD_DIM_MAX; col++) {
                s_K[K_IDX(k_row, col)] = 0.0;
            }
        }

        subgroupBarrier();

        // ========================================
        // Compute attention scores using MMA
        // ========================================
        // Each lane computes: result_row_lane = sum over k of Q_row_lane * K_col_lane
        // Result is M×N where M=2 (two rows per lane), N=32 (one column per lane)

        // Initialize result for this K block
        vec2 result_acc = vec2(0.0, 0.0);

        // MMA inner loop
        for (uint k_idx = 0; k_idx < actual_head_dim; k_idx += K) {
            // Matrix A (Q): 2×K per lane, packed in VNNI layout
            // Lane 0-15: rows 0-7, Lane 16-31: rows 8-15
            // Each lane contributes 2 consecutive K elements
            vec2 a_row0, a_row1;

            // Load Q for this K block
            // Row 0: lane%8, Row 1: (lane%8)+8
            uint q_row0 = lane_id % 8;
            uint q_row1 = q_row0 + 8;

            a_row0.x = s_Q[Q_IDX(q_row0, k_idx)];
            a_row0.y = s_Q[Q_IDX(q_row0, k_idx + 1)];
            a_row1.x = s_Q[Q_IDX(q_row1, k_idx)];
            a_row1.y = s_Q[Q_IDX(q_row1, k_idx + 1)];

            // Matrix B (K^T): K×32, each lane has one column
            // Lane i owns column i of K^T
            // Load K^T column for this lane (K elements)
            vec2 b_col0, b_col1;
            b_col0.x = s_K[K_IDX(k_row, k_idx)];
            b_col0.y = s_K[K_IDX(k_row, k_idx + 1)];
            b_col1.x = (k_idx + 2 < actual_head_dim) ? s_K[K_IDX(k_row, k_idx + 2)] : 0.0;
            b_col1.y = (k_idx + 3 < actual_head_dim) ? s_K[K_IDX(k_row, k_idx + 3)] : 0.0;

            // MMA: result += A × B
            // A is 2×K, B is K×1 (per lane), result is 2×1
            // Compute dot product for each row
            result_acc.x += dot(vec2(a_row0.x, a_row0.y), vec2(b_col0.x, b_col0.y));
            result_acc.x += dot(vec2(a_row1.x, a_row1.y), vec2(b_col1.x, b_col1.y));
        }

        // Store attention score to shared memory
        // Each lane stores its result to s_S[row, col]
        uint my_row = lane_id % 8; // Lane 0-7: row 0, Lane 8-15: row 1 (for 16 rows total)
        uint my_col = kv_start + lane_id;

        // Map lanes 0-15 to rows 0-7 (2 lanes per output row)
        // Lane 0,8 → row 0; Lane 1,9 → row 1; etc.
        uint s_row = (lane_id % 8);
        uint s_col = lane_id; // Each lane stores at its column position

        if (s_col < BLOCK_SIZE_N) {
            s_S[S_IDX(s_row, s_col)] = result_acc.x * params.scale;
        }
        // Lane 16-31 stores to rows 8-15
        if (lane_id >= 8) {
            s_S[S_IDX(s_row + 8, lane_id - 8)] = result_acc.y * params.scale;
        }

        subgroupBarrier();

        // ========================================
        // Softmax & Update Accumulator
        // ========================================
        if (lane_id < BLOCK_SIZE_M) {
            uint r = lane_id;

            // Apply causal masking
            for (uint c = 0; c < BLOCK_SIZE_N; c++) {
                uint g_c = kv_start + c;
                float val = s_S[S_IDX(r, c)];
                bool masked = false;
                if (g_c >= params.seq_len) masked = true;
                if (params.causal != 0u and g_c > (global_row_base + r)) masked = true;
                if (masked) val = -1e30;
                s_S[S_IDX(r, c)] = val;
            }

            if (is_active_base and (global_row_base + r) < params.seq_len) {
                // Find block max
                float block_max = -1e30;
                for (uint c = 0; c < BLOCK_SIZE_N; c++) {
                    block_max = max(block_max, s_S[S_IDX(r, c)]);
                }

                // Update running max and sum
                float new_max = max(row_max, block_max);
                float scale_factor = exp(row_max - new_max);
                row_sum *= scale_factor;
                for (uint d = 0; d < HEAD_DIM_MAX; d++) output_acc[d] *= scale_factor;

                // Compute softmax and accumulate output
                float block_sum = 0.0;
                for (uint c = 0; c < BLOCK_SIZE_N; c++) {
                    float p = exp(s_S[S_IDX(r, c)] - new_max);
                    block_sum += p;
                    for (uint d = 0; d < actual_head_dim; d++) {
                        output_acc[d] += p * s_V[V_IDX(c, d)];
                    }
                }
                row_sum += block_sum;
                row_max = new_max;
            }
        }

        subgroupBarrier();
    }

    // ========================================
    // Write Output (Pack float → BF16)
    // ========================================
    uint output_row = lane_id % 8;
    uint g_row = global_row_base + output_row;

    if (g_row < params.seq_len and is_active_base) {
        float inv_sum = 1.0 / row_sum;
        for (uint d = 0; d < actual_head_dim; d++) {
            O.data[base_offset + g_row * params.head_dim + d] = packBfloat16(output_acc[d] * inv_sum);
        }
        if (params.store_lse != 0u) {
            LSE.data[lse_offset + g_row] = packBfloat16(row_max + log(row_sum));
        }
    }
}
